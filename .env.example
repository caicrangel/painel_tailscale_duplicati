# ─── Banco ────────────────────────────────────────────────────────────────────
# Escolha uma senha qualquer aqui. O banco é criado com ela na primeira vez que
# o container do Postgres sobe (e só nessa primeira vez — se mudar depois, apague
# o volume com `docker compose down -v` ou a senha antiga continua valendo).
POSTGRES_PASSWORD="troque-esta-senha"
POSTGRES_USER="painel"
POSTGRES_DB="painel"

# ATENÇÃO — DATABASE_URL: em Docker esta linha é IGNORADA. O docker-compose.yml
# monta a URL sozinho, a partir de POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB,
# apontando para o host "postgres". Ela só é usada quando você roda a aplicação
# direto na máquina (npm run dev), sem container. Nesse caso a senha aqui precisa
# ser a mesma de POSTGRES_PASSWORD.
DATABASE_URL="postgresql://painel:troque-esta-senha@localhost:5432/painel?schema=public"

# ─── Aplicação ────────────────────────────────────────────────────────────────
TZ="America/Sao_Paulo"

# Em qual interface o Docker publica a porta 3000.
# Use o IP 100.x desta máquina na tailnet — descubra com: tailscale ip -4
# O default (127.0.0.1) aceita conexão só da própria máquina, e aí as máquinas
# dos clientes não conseguem entregar os relatórios do Duplicati.
BIND_ADDRESS="127.0.0.1"

# Outros endereços pelos quais o painel é alcançado, separados por vírgula
# (o de APP_BASE_URL já entra sozinho). É a lista que as Server Actions aceitam
# como origem; quem alcança o painel por IP e por MagicDNS precisa dos dois aqui.
# Sintoma de faltar um: o formulário falha com erro de origem inválida.
#   SERVER_ACTIONS_ORIGINS="100.83.12.47:3000,painel.tailXXXX.ts.net:3000"
SERVER_ACTIONS_ORIGINS=""

# URL pela qual as máquinas dos clientes alcançam o painel na tailnet.
# É a base do snippet --send-http-url mostrado na tela de Clientes.
# Pode ser o IP (http://100.83.12.47:3000) ou o nome MagicDNS.
APP_BASE_URL="http://painel.tailXXXX.ts.net:3000"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32 e cole o resultado literal aqui.
# O .env não é interpolado pelo shell: "$(openssl rand -base64 32)" NÃO funciona.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Deixe false enquanto servir HTTP puro dentro da tailnet. true exige HTTPS.
AUTH_COOKIE_SECURE="false"

# Admin inicial criado pelo seed. Você escolhe estes valores agora — é a conta
# que vai existir no primeiro login. Senha: mínimo 12 caracteres, com ao menos
# uma letra e ao menos um número ou símbolo.
#   Docker: docker compose run --rm worker npm run db:seed
#   Local:  npm run db:seed
# Depois do primeiro login, troque a senha na tela e apague a linha abaixo.
SEED_ADMIN_EMAIL="admin@exemplo.com.br"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"

# ─── Tailscale (OAuth client, escopo devices:core:read) ───────────────────────
TAILSCALE_OAUTH_CLIENT_ID=""
TAILSCALE_OAUTH_CLIENT_SECRET=""
TAILSCALE_TAILNET="-"
MAGICDNS_DOMAIN="tailXXXX.ts.net"

# Chave para cifrar os segredos que a tela de Configurações guarda no banco
# (token do bot, senha de SMTP). Se ficar vazia, o AUTH_SECRET é usado.
# Trocar esta chave torna os segredos já salvos ilegíveis — reconfigure-os na tela.
SETTINGS_ENCRYPTION_KEY=""

# ─── Telegram (bot único, chat global) ────────────────────────────────────────
# Estes valores são o ponto de partida: a tela Configurações → Telegram
# sobrescreve o que estiver aqui, sem precisar reiniciar o container.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ENABLED="false"

# ─── Limiares (defaults; podem ser sobrescritos na tabela Setting) ────────────
MACHINE_ONLINE_MAX_MINUTES="5"
MACHINE_IDLE_MAX_MINUTES="60"
MACHINE_OFFLINE_ALERT_MINUTES="60"
DEFAULT_JOB_INTERVAL_MINUTES="1440"
DEFAULT_JOB_TOLERANCE_MINUTES="360"
ALERT_ON_WARNING="false"

# ─── Rate limit ───────────────────────────────────────────────────────────────
INGEST_RATE_LIMIT_PER_MINUTE="60"
LOGIN_RATE_LIMIT_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"

# ─── Worker ───────────────────────────────────────────────────────────────────
CRON_TAILSCALE_SYNC="*/2 * * * *"
CRON_LATE_CHECK="*/5 * * * *"
CRON_ALERTS="* * * * *"
CRON_NOTIFY="* * * * *"
# Dias até o payload bruto ser expurgado. Ele guarda a topologia do cliente
# (nomes de job, caminhos, volumes) e serve para corrigir o parser quando ele
# erra — depois de alguns meses não serve mais para nada e vira só exposição.
# As métricas já interpretadas ficam no histórico para sempre; só o JSON some.
# 0 = nunca expurgar. Este valor é o padrão: a tela Configurações → Monitoramento
# tem precedência assim que você salvar algo lá.
RAW_PAYLOAD_RETENTION_DAYS="90"

# Resolvers DNS dos containers. O padrão do Docker herda o resolver do host,
# que numa máquina com Tailscale costuma ser o MagicDNS (100.100.100.100) —
# inalcançável de dentro do container. Ajuste se a rede exigir DNS interno.
DNS_PRIMARIO="1.1.1.1"
DNS_SECUNDARIO="8.8.8.8"
